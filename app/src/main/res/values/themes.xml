<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Viktus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
    </style>

    <style name="Theme.Viktus" parent="Base.Theme.Viktus" />

    <style name="App.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">36dp</item>
        <item name="android:height">36dp</item>
        <item name="android:color">@color/footer_indicator</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemIconTint">@color/footer_icon</item>
        <item name="itemIconSize">24dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="itemPaddingTop">0dp</item>
        <item name="itemPaddingBottom">0dp</item>
    </style>

    <style name="App.Fab.Round" parent="Base.Theme.Viktus" >
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>