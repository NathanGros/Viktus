<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Viktus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
    </style>

    <style name="Theme.Viktus" parent="Base.Theme.Viktus" />

    <style name="App.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">36dp</item>
        <item name="android:height">36dp</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Small</item>
    </style>

    <style name="App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemIconTint">@color/footer_icon</item>
        <item name="itemIconSize">24dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="itemPaddingTop">0dp</item>
        <item name="itemPaddingBottom">0dp</item>
    </style>

    <style name="App.Fab.RoundRect" parent="Base.Theme.Viktus" >
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="App.MaterialButton.RoundRect" parent="Widget.Material3.Button.IconButton.Filled" >
        <item name="cornerRadius">10dp</item>
        <item name="iconSize">26sp</item>
    </style>

    <style name="App.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="hintTextColor">@color/text_primary</item>
        <item name="cursorColor">@color/text_primary</item>
        <item name="errorTextColor">@color/danger</item>
        <item name="cursorErrorColor">@color/danger</item>item>
    </style>
</resources>