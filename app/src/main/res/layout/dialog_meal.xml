<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Edit / Add only -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_name"
                style="@style/App.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/name"
                android:textColorHint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_description"
                style="@style/App.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/description"
                android:textColorHint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- View only -->
            <TextView
                android:id="@+id/text_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:visibility="gone"
                android:textColor="@color/text_primary"/>

            <!-- Image: tap to pick in Add/Edit, display only in View -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/image_card"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/main_item_image_border"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/app_background"
                android:backgroundTint="@color/app_background"
                app:rippleColor="@color/fab_ripple">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/tap_to_add_image"
                        android:textColor="@color/text_secondary"
                        android:textStyle="italic"/>

                    <ImageView
                        android:id="@+id/meal_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_remove_image"
                        style="@style/App.MaterialButton.RoundRect"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:iconGravity="textStart"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:padding="0dp"
                        android:contentDescription="@string/remove_image"
                        android:visibility="gone"
                        app:icon="@drawable/ic_trash"
                        app:backgroundTint="@color/danger"
                        app:iconTint="@color/white"
                        app:rippleColor="@color/fab_ripple"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="30dp" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/supplies"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/text_primary"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_ingredient"
                    style="@style/App.MaterialButton.RoundRect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:iconGravity="textStart"
                    android:padding="0dp"
                    android:contentDescription="@string/add_supply"
                    app:icon="@drawable/ic_add"
                    app:backgroundTint="@color/fab_background"
                    app:iconTint="@color/fab_icon"
                    app:rippleColor="@color/fab_ripple"/>
            </LinearLayout>

            <TextView
                android:id="@+id/empty_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/empty_ingredients"
                android:alpha="0.5"
                android:textStyle="italic"
                android:visibility="gone"
                android:textColor="@color/text_secondary"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ingredients_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer for Add / Edit: Delete (edit only) on the left, Cancel + confirm on the right -->
    <LinearLayout
        android:id="@+id/footer_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/App.MaterialButton.RoundRect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_trash"
            app:backgroundTint="@color/danger"
            app:iconTint="@color/white"
            app:rippleColor="@color/fab_ripple" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:rippleColor="@color/fab_ripple"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:cornerRadius="10dp"
            android:textColor="@color/fab_icon"
            android:backgroundTint="@color/fab_background"
            app:rippleColor="@color/fab_ripple"/>
    </LinearLayout>

    <!-- Footer for View: Delete + Eaten -->
    <LinearLayout
        android:id="@+id/footer_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_delete"
            style="@style/App.MaterialButton.RoundRect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_trash"
            app:backgroundTint="@color/danger"
            app:iconTint="@color/white"
            app:rippleColor="@color/fab_ripple"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:rippleColor="@color/fab_ripple"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_eaten"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:cornerRadius="10dp"
            android:textColor="@color/fab_icon"
            android:backgroundTint="@color/fab_background"
            app:rippleColor="@color/fab_ripple"
            android:text="@string/eaten" />
    </LinearLayout>

    <!-- Footer for History: Save + Add -->
    <LinearLayout
        android:id="@+id/footer_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_history_save"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_meal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_to_planned" />
    </LinearLayout>
</LinearLayout>