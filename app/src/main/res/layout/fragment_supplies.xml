<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="40dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/App.Input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_supplies"
                app:endIconMode="clear_text"
                android:textColorHint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_supply"
                style="@style/App.MaterialButton.RoundRect"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="3dp"
                android:contentDescription="@string/add_supply"
                android:padding="0dp"
                app:backgroundTint="@color/fab_background"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/fab_icon" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/supplies_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/supplies_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_supplies"
        android:textStyle="italic"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_used"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="38dp"
        android:minHeight="0dp"
        android:text="@string/used_shown"
        android:textColor="@color/fab_icon"
        app:elevation="0dp"
        app:pressedTranslationZ="0dp"
        app:hoveredFocusedTranslationZ="0dp"
        android:stateListAnimator="@null"
        app:borderWidth="0dp"
        app:shapeAppearanceOverlay="@style/App.Fab.RoundRect"
        app:backgroundTint="@color/fab_background"
        app:rippleColor="@color/fab_ripple" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_copy_clipboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="38dp"
        android:contentDescription="@string/copy_clipboard"
        app:srcCompat="@drawable/ic_copy"
        app:fabCustomSize="50dp"
        app:maxImageSize="30dp"
        app:elevation="0dp"
        app:pressedTranslationZ="0dp"
        app:hoveredFocusedTranslationZ="0dp"
        app:borderWidth="0dp"
        app:shapeAppearanceOverlay="@style/App.Fab.RoundRect"
        app:backgroundTint="@color/fab_background"
        app:tint="@color/fab_icon"
        app:rippleColor="@color/fab_ripple" />
</FrameLayout>